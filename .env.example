# =====================================================================
# Environment Configuration Template
# 
# IMPORTANT:
# - Copy this file to '.env' and fill in your private API credentials.
# - Never commit your actual '.env' file or expose API keys.
# =====================================================================

# Mistral AI API Key (Required for Summarization, Insights Extraction & RAG)
# Obtain from https://console.mistral.ai/
MISTRAL_API_KEY=

# Mistral Model Selection
# Note: Model availability and rate limits depend on your Mistral AI account tier.
# 'open-mistral-7b' is recommended for standard/free tier accounts to prevent rate limits.
MISTRAL_MODEL=open-mistral-7b

# Sarvam AI API Key (Required for Hindi/Hinglish to English Translation)
# Obtain from https://sarvam.ai/
SARVAM_API_KEY=

# Local Whisper Model Selection (CPU/GPU)
# Options: 'tiny', 'base', 'small', 'medium', 'large'
WHISPER_MODEL=small
